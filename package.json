{
  "name": "family-home-page",
  "version": "1.0.0",
  "description": "家庭主页 - PWA 应用",
  "private": true,
  "scripts": {
    "start": "npx serve .",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "lint": "eslint \"**/*.js\" --fix",
    "check": "prettier --check \"**/*.{html,css,js,json,md}\" && eslint \"**/*.js\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "eslint": "^8.50.0",
    "serve": "^14.0.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100
  }
}
